.DS_Store
node_modules/
dist/
*.local

# 環境変数。SupabaseのURLとキーがここに入るので絶対にコミットしない
.env
.env.*
!.env.example

# Claude Code のローカル設定（許可コマンドなど）。マシンごとに違うので共有しない。
# 起動設定の .claude/launch.json は共有したいのでコミットしている。
.claude/settings.local.json

# Swift Package Manager のビルド成果物
ios/**/.build/

# Xcodeプロジェクトは project.yml から生成する（xcodegen generate）。
# 巨大なXMLで差分が読めず、競合も解けないためリポジトリには入れない
ios/RinkoApp/*.xcodeproj/
ios/RinkoApp/RinkoApp/Info.plist
